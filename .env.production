# Адрес приёма заявок для production-сборки (abg.hiborg-space.ru).
#
# Приёмник — сервис abg-leads на VPS (systemd), POST /leads через nginx:
# заявка сохраняется в SQLite + CSV и уведомлением уходит в Telegram.
# Описание и переключение канала (CRM/SMTP) — docs/leads-channel.md
#
# Для встраивания виджета на другом домене адрес можно переопределить в рантайме,
# до загрузки скрипта виджета:
#   <script>window.ABG3D_LEADS_ENDPOINT = 'https://…';</script>
VITE_LEADS_ENDPOINT=https://abg.hiborg-space.ru/api/leads
